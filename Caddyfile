{
	admin off
	persist_config off
	auto_https off

  {$CADDY_GLOBAL_OPTIONS}

  log {
    format json
    output stderr
    level DEBUG
  }

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
    root * /app/public

	# En-têtes de sécurité (audit croisé 2026-08-22, IFO-015). Le HSTS n'a d'effet
	# que via le proxy HTTPS de Coolify : les navigateurs l'ignorent en HTTP local.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	encode zstd br gzip

	file_server {
		hide .git
		hide .env*
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
