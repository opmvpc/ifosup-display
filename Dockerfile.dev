# Image de développement : le code est monté en volume, rien n'est copié ici.
FROM dunglas/frankenphp:php8.4-bookworm

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs git unzip && \
    npm install -g pnpm@10 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN install-php-extensions pdo_mysql bcmath gd zip intl pcntl opcache xdebug

# Mêmes limites PHP qu'en production (upload de slides et d'Excel > 2 Mo),
# sur la base development pour garder l'affichage des erreurs.
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"
COPY docker/php.ini "$PHP_INI_DIR/conf.d/99-ifosup.ini"

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY docker/dev-entrypoint.sh /dev-entrypoint.sh
RUN chmod +x /dev-entrypoint.sh

EXPOSE 8000 5173
ENTRYPOINT ["/dev-entrypoint.sh"]
CMD ["serve"]
